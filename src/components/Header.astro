---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

{/*
  The mobile menu is a native <details> disclosure: correct semantics and keyboard
  behaviour with no JavaScript, and it still works if the island bundle never loads.
*/}
<header
  class="sticky top-0 z-40 border-b border-line/80 bg-canvas/85 backdrop-blur-md supports-[backdrop-filter]:bg-canvas/70"
>
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a
      href="#top"
      class="font-display text-lg font-semibold tracking-tight text-ink"
      aria-label={`${site.name} — back to top`}
    >
      Niamh King
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {/* Desktop navigation */}
      <nav aria-label="Sections" class="hidden md:block">
        <ul class="flex items-center gap-1">
          {
            nav.map((item) => (
              <li>
                <a
                  data-nav
                  href={item.href}
                  class="inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-sunken hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ThemeToggle />

      {/* Mobile menu */}
      <details class="group relative md:hidden" name="mobile-nav">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-line text-ink transition-colors hover:bg-sunken [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
        >
          <svg
            class="h-5 w-5 group-open:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="hidden h-5 w-5 group-open:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>

        <nav
          aria-label="Sections"
          class="card absolute right-0 mt-2 w-52 origin-top-right overflow-hidden p-1.5"
        >
          <ul class="flex flex-col">
            {
              nav.map((item) => (
                <li>
                  <a
                    data-nav
                    href={item.href}
                    class="flex items-center rounded-lg px-3 py-2.5 text-sm font-medium text-muted transition-colors hover:bg-sunken hover:text-ink"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile disclosure after a jump, and on Escape or an outside click.
  const menu = document.querySelector<HTMLDetailsElement>('details[name="mobile-nav"]');
  if (menu) {
    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menu.open = false;
      })
    );
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
