---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="shell flex flex-col gap-4 py-8 text-sm text-faint sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {site.name}</p>
    <p class="text-balance">
      Built with Astro, React and Tailwind CSS. <a
        class="underline decoration-line underline-offset-4 transition-colors hover:text-ink"
        href={site.links.github}
        rel="me noopener">Source on GitHub</a
      >.
    </p>
  </div>
</footer>
