---
import { experience, skills } from '../data/site';
import SectionHeading from './SectionHeading.astro';

// Consecutive roles at the same employer are grouped so the progression reads as
// one tenure with two titles, rather than two unrelated jobs.
type Group = { org: string; roles: typeof experience };

const groups = experience.reduce<Group[]>((acc, role) => {
  const last = acc.at(-1);
  if (last && last.org === role.org) last.roles.push(role);
  else acc.push({ org: role.org, roles: [role] });
  return acc;
}, []);
---

<section id="work" class="section border-b border-line" aria-labelledby="work-heading">
  <div class="shell">
    <SectionHeading
      id="work-heading"
      eyebrow="Experience"
      title="Where I've worked"
      lead="Eighteen months of commercial delivery at a UK software development and AI company, across concurrent client projects in whatever stack the problem calls for."
    />

    <div class="mt-12 flex flex-col gap-10 sm:gap-12">
      {
        groups.map((group) => (
          <article class="grid gap-6 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] md:gap-10">
            <div class="md:sticky md:top-24 md:self-start">
              <h3 class="text-[length:var(--text-h3)] leading-tight">{group.org}</h3>
              <p class="mt-1 text-sm text-faint">
                {group.roles.at(-1)?.period.split('—')[0]?.trim()} —{' '}
                {group.roles[0]?.current ? 'present' : group.roles[0]?.period.split('—')[1]?.trim()}
              </p>
            </div>

            <div class="flex flex-col gap-8">
              {group.roles.map((role) => (
                <div class="card p-5 sm:p-7">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h4 class="text-lg font-semibold tracking-tight">{role.title}</h4>
                    <p class="font-mono text-xs text-faint">{role.period}</p>
                  </div>

                  {role.current && (
                    <p class="mt-2">
                      <span class="tag border-accent/40 bg-accent-soft text-accent">
                        Current role
                      </span>
                    </p>
                  )}

                  <p class="mt-3 text-[0.975rem] leading-relaxed text-muted">{role.blurb}</p>

                  <ul class="mt-4 flex flex-col gap-2.5">
                    {role.points.map((point) => (
                      <li class="relative pl-5 text-[0.925rem] leading-relaxed text-muted">
                        <span
                          aria-hidden="true"
                          class="absolute top-[0.6em] left-0 h-1.5 w-1.5 rounded-full bg-accent"
                        />
                        {point}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-14 border-t border-line pt-10 sm:mt-16 sm:pt-12">
      <h3 class="text-[length:var(--text-h3)] leading-tight">What I work with</h3>
      <p class="prose-body mt-3">
        Not a fixed stack. Each project picked its own tools, so this is what I have actually built
        and shipped with — and most of it I picked up on the project that needed it.
      </p>

      <ul class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
        {
          skills.map((group) => (
            <li>
              <h4 class="font-sans text-sm font-semibold tracking-tight text-ink">
                {group.heading}
              </h4>
              <ul class="mt-2.5 flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
