---
import { education, honours, beyond } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section id="background" class="section border-b border-line" aria-labelledby="background-heading">
  <div class="shell">
    <SectionHeading
      id="background-heading"
      eyebrow="Background"
      title="How I got here"
      lead="The degree, what it came with, and the things outside a job that shaped what I ended up doing."
    />

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
      <div class="flex flex-col gap-8">
        <div class="card p-5 sm:p-7">
          <h3 class="text-[length:var(--text-h3)] leading-tight">Education</h3>
          <p class="mt-3 font-semibold text-ink">{education.degree}</p>
          <p class="mt-1 text-sm text-faint">
            {education.institution} · {education.period}
          </p>
          <p class="mt-3 text-[0.925rem] leading-relaxed text-muted">{education.detail}</p>
        </div>

        <div>
          <h3 class="text-[length:var(--text-h3)] leading-tight">Awards</h3>
          <ul class="mt-5 flex flex-col gap-5">
            {
              honours.map((item) => (
                <li>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                    <p class="font-semibold text-ink">{item.title}</p>
                    <p class="font-mono text-xs text-faint">{item.period}</p>
                  </div>
                  <p class="mt-1 text-[0.9rem] leading-relaxed text-muted">{item.detail}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div>
        <h3 class="text-[length:var(--text-h3)] leading-tight">Outside work</h3>
        <ul class="mt-5 flex flex-col gap-5">
          {
            beyond.map((item) => (
              <li class="border-l-2 border-line pl-4">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                  <p class="font-semibold text-ink">{item.title}</p>
                  {item.period && <p class="font-mono text-xs text-faint">{item.period}</p>}
                </div>
                {item.detail && (
                  <p class="mt-1 text-[0.9rem] leading-relaxed text-muted">{item.detail}</p>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
